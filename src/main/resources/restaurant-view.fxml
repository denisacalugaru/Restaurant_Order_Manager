<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #1e242b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="service.RestaurantController">
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #2b343e; -fx-border-color: #00a896; -fx-border-width: 1; -fx-border-radius: 5;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="MENIU" textFill="#00a896">
                <font><Font name="Segoe UI Bold" size="12.0" /></font>
            </Label>
            <ListView fx:id="menuListView" prefWidth="250.0" style="-fx-background-color: #35404d; -fx-control-inner-background: #35404d; -fx-text-fill: white;" VBox.vgrow="ALWAYS" />
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="5.0" top="15.0" />
            </BorderPane.margin>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2b343e; -fx-border-color: #00a896; -fx-border-width: 1; -fx-border-radius: 5;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <Label text="REZERVA MASA " textFill="#00a896">
                <font><Font name="Segoe UI Bold" size="12.0" /></font>
            </Label>
            <VBox spacing="5.0">
                <Label text="Numar Masa:" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Label>
                <TextField fx:id="txtNumarMasa" prefWidth="120.0" promptText="Ex: 5" style="-fx-background-color: #35404d; -fx-text-fill: white; -fx-padding: 8;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Capacitate:" textFill="WHITE">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Label>
                <TextField fx:id="txtCapacitate" prefWidth="120.0" promptText="Ex: 4" style="-fx-background-color: #35404d; -fx-text-fill: white; -fx-padding: 8;" />
            </VBox>
            <Button fx:id="btnSave" maxWidth="1.7976931348623157E308" onAction="#onSaveButtonClick" style="-fx-background-color: #00a896; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="SALVEAZA REZERVARE">
                <VBox.margin><Insets top="15.0" /></VBox.margin>
                <padding><Insets bottom="12.0" top="12.0" /></padding>
            </Button>
            <BorderPane.margin>
                <Insets bottom="15.0" left="5.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </VBox>
    </center>
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleGolesteFormular" text="Adauga Produs" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleDeleteMasa" text="Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
